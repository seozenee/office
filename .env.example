# ---------------------------------------------------------------------------
# Personal AI Office — copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Security (REQUIRED in production) ---
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USERNAME=ceo
ADMIN_PASSWORD=change-me
AUTH_ENABLED=true
CORS_ORIGINS=http://localhost:3000

# --- LLM (Model Router) ---
# Without ANTHROPIC_API_KEY the office runs in offline mode: planning/extraction/analysis use
# deterministic rules and never invent content (unknowns are shown as UNKNOWN).
ANTHROPIC_API_KEY=
# auto | anthropic | offline
LLM_PROVIDER=auto
# chat, DMs, classification
MODEL_FAST=claude-haiku-4-5
# planning, analysis, critique, writing
MODEL_REASONING=claude-opus-5
# coding agent
MODEL_CODING=claude-opus-5
# claim extraction from long documents
MODEL_LONG_CONTEXT=claude-opus-5
# images / PDFs
MODEL_MULTIMODAL=claude-opus-5

# --- Web research (set ONE search provider) ---
# auto | tavily | brave | serper | searxng | fixture | none
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=
# e.g. http://localhost:8080 (self-hosted, no key)
SEARXNG_URL=
# Research snapshot replay (offline demos / reproducible runs / tests):
FIXTURE_SEARCH_FILE=
FETCH_MIRROR_DIR=
MAX_SOURCES_PER_TASK=12

# --- Browser / computer agent (Playwright) ---
BROWSER_ENABLED=true
# comma-separated allow-list; empty = any public site
BROWSER_ALLOWED_DOMAINS=
BROWSER_RENDER_FALLBACK=true

# --- Embeddings ---
# hash (local, no key) | voyage
EMBEDDING_PROVIDER=hash
VOYAGE_API_KEY=

# --- Storage ---
# SQLite (default) or PostgreSQL:
# DATABASE_URL=postgresql+psycopg://office:office-dev-password@postgres:5432/office
DATABASE_URL=
POSTGRES_PASSWORD=office-dev-password

# --- Jobs / quality ---
TIMEZONE=Asia/Seoul
# run jobs inside the API process (docker-compose uses a separate worker)
INLINE_WORKER=true
# pause between meeting lines so you can watch the office (0 = full speed)
OFFICE_PACE_SECONDS=1.0
STALE_AFTER_YEARS=3
MIN_VERIFIED_RATIO=0.5
MAX_RESEARCH_ROUNDS=2

# --- Frontend ---
PUBLIC_API_URL=http://localhost:8000

# --- Plugins (optional; each is enabled when its variables are set) ---
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=
DISCORD_WEBHOOK_URL=
GITHUB_TOKEN=
NOTION_TOKEN=
# Gmail / Calendar / Drive / Sheets (OAuth access token)
GOOGLE_ACCESS_TOKEN=
DROPBOX_TOKEN=
